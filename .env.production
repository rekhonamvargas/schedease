# Production Environment Variables
REACT_APP_ENV=production
REACT_APP_API_URL=https://api.schedease.com/api

# Security Settings (strict for production)
REACT_APP_ENABLE_CONSOLE_LOGS=false
REACT_APP_ENABLE_DEV_TOOLS_PROTECTION=true
REACT_APP_SESSION_TIMEOUT=3600000

# Feature Flags
REACT_APP_ENABLE_DEBUG_MODE=false
REACT_APP_ENABLE_DATA_VALIDATION=true
REACT_APP_ENABLE_RATE_LIMITING=true
REACT_APP_MAX_DATA_SIZE_MB=5

# Security Headers (configure on server)
# Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline';
# X-Frame-Options: DENY
# X-Content-Type-Options: nosniff
# Referrer-Policy: strict-origin-when-cross-origin
